# DeliveryFlow Backend — Environment Variables

# Application
APP_NAME=DeliveryFlow
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://df_user:df_password@localhost:5432/deliveryflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=RS256

# Object Storage (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=seaweed
S3_SECRET_KEY=seaweed
S3_BUCKET=deliveryflow
S3_REGION=us-east-1

# WhatsApp (Phase 2)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Driver's Pack
DRIVERS_PACK_EXPIRY_DAYS=365
