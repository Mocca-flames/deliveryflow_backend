# DeliveryFlow Backend — Environment Variables

# Application
APP_NAME=DeliveryFlow
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://df_user:df_password@localhost:5432/deliveryflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256

# Object Storage (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=seaweed
S3_SECRET_KEY=seaweed
S3_BUCKET=deliveryflow
S3_REGION=us-east-1

# WhatsApp (Phase 2)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Driver's Pack
DRIVERS_PACK_EXPIRY_DAYS=365

# LLM Document Extraction (Vision LLM — multi-provider)
LLM_ENABLED=true
LLM_PROVIDERS=mistral,google

# Mistral (primary)
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=ministral-14b-latest

# Google Gemini (fallback)
GOOGLE_API_KEY=
GOOGLE_VISION_MODEL=gemini-2.5-flash

# OpenRouter (optional fallback)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# LLM concurrency control
LLM_MAX_CONCURRENT_PAGES=3
